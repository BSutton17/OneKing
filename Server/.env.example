# Port the server listens on (Heroku sets this for you)
PORT=3001
# Comma-separated client origins allowed to connect. Empty or "*" = any (fine:
# no cookies are used). In production you can pin it, e.g. https://yourgame.netlify.app
CLIENT_ORIGINS=
# Where rooms are saved so games survive a restart. Leave MONGODB_URI empty to
# save JSON files in DATA_DIR instead (zero setup for local development).
DATA_DIR=./data
MONGODB_URI=
