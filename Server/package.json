{
  "name": "one-king-one-crown-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Socket.IO server for One King One Crown",
  "license": "CC-BY-NC-SA-4.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "catalog:doc": "tsx scripts/catalogDoc.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2"
  }
}
